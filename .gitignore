# build artifacts
node_modules/
dist/
target/

# runtime state — never commit vault material.
# flow.cfg is the plaintext pointer, chrome.cfg the plaintext decoy title (both sit
# beside the exe), and *.db / *-journal are what a vault root looks like when someone
# renames the folder — the goonflow-vault/ entry alone stops nothing else.
flow.cfg
chrome.cfg
goonflow-vault/
*.db
*.db-wal
*.db-shm
*-journal
*.log

# scratch build logs (tools/) and the one-build-at-a-time lock run-release.ps1 holds
tools/*.log
tools/last-build.lock
# machine-local evidence written by tools/run-test.ps1 + run-release.ps1
tools/last-*.txt

# editors / os
.DS_Store
.idea/
.vscode/
